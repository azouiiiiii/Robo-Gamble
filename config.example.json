{
    "platform": {
        "mode": "api",
        "server": {
            "host": "0.0.0.0",
            "port": 8765
        },
        "field_map": {
            "phase":             "current_stage",
            "hand":              "my_cards",
            "public_cards":      "community_cards",
            "pot":               "total_pot",
            "my_chips":          "player.stack",
            "to_call":           "required_call",
            "my_position":       "player.position",
            "opponent_actions":  "action_history",
            "opponent_chips":    "opponent.stack",
            "table_id":          "table.id",
            "round_id":          "round.id"
        },
        "action_api": {
            "url": "http://localhost:9999/api/act",
            "method": "POST",
            "headers": {
                "Content-Type": "application/json"
            },
            "body_template": {
                "move": "{{action}}",
                "amount": "{{amount}}"
            }
        }
    },
    "bridge": {
        "game_url": "http://localhost:7001",
        "auto_mode": false,
        "headless": false,
        "suggestion_timeout": 5000,
        "mode": "verify",
        "capture": {
            "session_dir": "learning_sessions",
            "boundary_key": "backquote",
            "overlap_ms": 1000
        },
        "network_capture": {
            "enabled": true,
            "resource_types": ["fetch", "xhr"],
            "content_types": ["application/json", "text/"],
            "capture_request": false,
            "capture_response": true,
            "capture_failed": true,
            "capture_request_headers": true,
            "capture_response_headers": true,
            "capture_request_body": false,
            "max_body_bytes": 65536,
            "max_queue_size": 500,
            "batch_size": 20,
            "flush_interval_ms": 200,
            "send_timeout_seconds": 5,
            "redact_headers": [
                "authorization",
                "proxy-authorization",
                "cookie",
                "set-cookie",
                "x-api-key",
                "x-auth-token",
                "x-csrf-token"
            ]
        }
    },
    "ai": {
        "model": "deepseek-v4-flash",
        "opponent_model": "deepseek-v4-flash",
        "base_url": "https://api.deepseek.com",
        "api_key": "<your-api-key>",
        "thinking": true,
        "reasoning_effort": "high"
    }
}
